// Stage E3 (f_tf_hatch v2): style + presence + encode. in1 = E2's aux2
// (raw lit-cells-crossed, pres, 0, 1). Mirrors tests/modules/tf_hatch/
// tf_hatch_mirror.py stage_e3 (sparse mode). The ONLY stage that clamps.
//
//   contrast  0..1  gain on the raw lit-cells-crossed value, 0.6 -> 2.0
//                   (PROVISIONAL, tier-3 confirms)
//   line_hard 0..1  0 = smooth field, 1 = hard engraved strokes (threshold at
//                   0.5 with a soft edge of half-width 0.5 -> 0.03)
//   presence multiplies the styled field (structure floor)
//   bypass_gate     black on both outlets, alpha 1 (outlet contract)
//
// out1 = module OUTLET 0: styled strokes, luma on black, A = 1 (color is
// downstream's job). out2 = module OUTLET 1: the unstyled normalized field
// (same luma without `line_hard`), A = 1 (spec OQ4).

Param contrast(0.5);
Param line_hard(0.0);
Param bypass_gate(0.0);

raw = nearest(in1, norm).x;
pres = nearest(in1, norm).y;

v = clamp(raw * (0.6 + contrast * 1.4), 0.0, 1.0);
w = 0.5 + (0.03 - 0.5) * line_hard;
hard = smoothstep(0.5 - w, 0.5 + w, v);
styled = v + (hard - v) * line_hard;

o0 = mix(styled * pres, 0.0, bypass_gate);
o1 = mix(v * pres, 0.0, bypass_gate);
out1 = vec(o0, o0, o0, 1.0);
out2 = vec(o1, o1, o1, 1.0);

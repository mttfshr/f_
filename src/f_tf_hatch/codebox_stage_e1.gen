// Stage E1 (f_tf_hatch v2): tensor decode + presence. in1 = the TENSOR
// (f_tf_tensormap outlet 0, raw float32; f_tensor_type.md encoding).
// Mirrors tests/modules/tf_hatch/tf_hatch_mirror.py stage_e1 (aux_mode
// "unsigned_nearest", spec OQ2 decided 2026-10-28). Intermediate texture,
// NEVER an outlet; unbounded float32 (no clamp, no 0.5 offset).
//
// out1 = (ca, sa, coh, pres):
//   (ca, sa)  cos/sin of the ALONG-structure axis + angle_offset*pi/2. The
//             axis is an unoriented line; E2 recovers sign continuity itself
//             (dot-product alignment), so this pair is read with `nearest`
//             only (interpolating it would flip sign at the horizontal cut).
//   coh       coherence (lambda1-lambda2)/(lambda1+lambda2), gain-free
//             (tensormap plan ADR-2). Enters E2 ONLY as direction persistence.
//   pres      PRESENCE: smooth ramp on the tensormap-encoded trace (R + B)
//             against structure_floor^2. Brightness gate only (E3 applies it).
//   Where trace <= eps_trace (zero / direction-undefined tensor): axis UNSET
//   (0, 0), coh 0, pres 0 -- never an atan2(0,0) artifact.
//
// DECODE IDIOM: .specify/f_tf_glyph/plan.md ADR-2 WITHOUT the gain divide (the Strength
// dial was removed 2026-10-29: axis and coherence are ratios and presence reads the
// encoded trace, so dividing the tensormap's gain back out changed nothing but the
// zero guard). Everything below is in ENCODED units (J * the tensormap's strength):
//   Jxx = R; Jxy = (G-0.5)*2; Jyy = B
//   theta = 0.5*atan2(2*Jxy, Jxx-Jyy)  (GRADIENT axis; along = theta + pi/2)
// The read is AT norm (texel centred, always in-bounds).

Param angle_offset(0.0);
Param structure_floor(0.1);

// zero-tensor guard on the ENCODED trace (was 1e-6 in J units = 1e-4 at strength 100)
eps_trace = 0.0001;

// (component access INLINE on sample(): on a stored variable it silently fails)
jxx = sample(in1, norm).r;
jxy = (sample(in1, norm).g - 0.5) * 2.0;
jyy = sample(in1, norm).b;
trace = jxx + jyy;
diff = jxx - jyy;
root = sqrt(diff*diff + 4.0*jxy*jxy);
theta = 0.5 * atan2(2.0*jxy, diff);

iso = 1.0 - step(eps_trace, trace);   // 1 = zero/undefined tensor
coh = clamp(root / max(trace, eps_trace), 0.0, 1.0);

eff = theta + halfpi + angle_offset * halfpi;
ca = cos(eff) * (1.0 - iso);
sa = sin(eff) * (1.0 - iso);

// presence: enc_trace = R + B = trace * the producing tensormap's strength.
// thr = floor^2 (finer at the low end); ramp 0.5*thr -> 1.5*thr (+ a hair, so
// floor 0 is a step at the iso guard).
enc_trace = sample(in1, norm).r + sample(in1, norm).b;
thr = structure_floor * structure_floor;
pres = smoothstep(0.5 * thr, 1.5 * thr + 0.000001, enc_trace) * (1.0 - iso);

out1 = vec(ca, sa, coh * (1.0 - iso), pres);

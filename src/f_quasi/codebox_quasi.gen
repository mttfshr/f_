// codebox_quasi.gen -- f_quasi: Shepard-zoom quasicrystal generator (working name, gate G1).
// Mirror: tests/modules/quasi/quasi_mirror.py (field, banded, encode_vec, render). Bench: tests/modules/quasi/bench_quasi.py.
//
// A stateless generator: five cosine plane waves (orientations k pi / 5 plus the angle) over seven octaves, the octave
// weights a Gaussian in log2 scale centred on 3 (envelope = sigma). The first inlet only drives the render and is never
// read; the aspect comes from the render context's dim (bench probe pending: see tasks.md T006a).
//   first outlet:  banded look of P: triangle fold of frac((P / 2 + 1) * bands), raised to 1.1
//   second outlet: the exact analytic gradient divided by the weighted total frequency, so |v| <= 1 (gate G2 proposal),
//                  encoded v * gain * 0.5 + 0.5 with B = 0.5, A = 1 (the f_vecfield contract)
//   third outlet:  the potential P mapped to 0..1 (P / 2 + 0.5)
// Settled by Phase 0 (.specify/f_quasi/tasks.md): units are frame HEIGHT (x is scaled by the aspect only); the five
// beta_k = frac(exp(pi k)) are float64 literals; no argument reduction (GPU error 3.7e-5 in P); drift is a phase in turns,
// wrapped here and applied as 2 pi drift 2^i so it is exactly periodic; zoom wraps here; the envelope cap (0.7) is the
// dial range, not enforced in this file; no octave skipping and no Nyquist fade (T005, T006).
// zoom_clk and drift_clk are the patcher clock's wrapped phases (per-frame accumulators, rate 0 freezes them exactly); they
// add to the zoom and drift dials, so a mod source can still drive the dials. src_mode is the dual-archetype flag from
// vs_inState (generator or processor); this module does not read it.
// bypass_gate = 1 (module bypass, never the native @bypass): first and third outlets black with alpha 1, second the
// neutral vecfield 0.5 / 0.5 / 0.5 / 1.
// Compile hazards avoided (skills/jit-gen-codebox): no unary minus before a product or parenthesis, no variables named
// e, phi, pi or cell, accumulators declared before the loop, no outlet names in comments.

Param zoom(0);
Param drift(0);
Param density(4);
Param envelope(0.5);
Param bands(5);
Param angle(0);
Param gain(1);
Param zoom_clk(0);
Param drift_clk(0);
Param src_mode(0);
Param bypass_gate(0);

asp = dim.x / dim.y;
px = (norm.x - 0.5) * asp;
py = norm.y - 0.5;
ztot = zoom + zoom_clk;
zw = ztot - floor(ztot);
dtot = drift + drift_clk;
dw = dtot - floor(dtot);
ang = angle * 0.017453292519943295;
ca = cos(ang);
sa = sin(ang);
twopib = twopi * density;
dx0 = 1.000000000000 * ca - 0.000000000000 * sa;
dy0 = 0.000000000000 * ca + 1.000000000000 * sa;
dx1 = 0.809016994375 * ca - 0.587785252292 * sa;
dy1 = 0.587785252292 * ca + 0.809016994375 * sa;
dx2 = 0.309016994375 * ca - 0.951056516295 * sa;
dy2 = 0.951056516295 * ca + 0.309016994375 * sa;
dx3 = (0 - 0.309016994375) * ca - 0.951056516295 * sa;
dy3 = 0.951056516295 * ca + (0 - 0.309016994375) * sa;
dx4 = (0 - 0.809016994375) * ca - 0.587785252292 * sa;
dy4 = 0.587785252292 * ca + (0 - 0.809016994375) * sa;
pacc = 0;
gxa = 0;
gya = 0;
wsum = 0;
wssum = 0;
pw2 = 1;
for (i = 0; i < 7; i += 1) {
    ex = zw + i;
    tz = (ex - 3) / envelope;
    wgt = exp(0 - 0.5 * tz * tz);
    sc = exp(ex * 0.6931471805599453);
    wsum += wgt;
    wssum += wgt * sc;
    ps0 = 0.000000000000 * sc + twopi * dw * pw2 + (dx0 * px + dy0 * py) * (twopib * sc);
    ps1 = 0.140692632779 * sc + twopi * dw * pw2 + (dx1 * px + dy1 * py) * (twopib * sc);
    ps2 = 0.491655524765 * sc + twopi * dw * pw2 + (dx2 * px + dy2 * py) * (twopib * sc);
    ps3 = 0.647807916694 * sc + twopi * dw * pw2 + (dx3 * px + dy3 * py) * (twopib * sc);
    ps4 = 0.313136653160 * sc + twopi * dw * pw2 + (dx4 * px + dy4 * py) * (twopib * sc);
    pacc += wgt * (cos(ps0) + cos(ps1) + cos(ps2) + cos(ps3) + cos(ps4));
    gxa += wgt * sc * (sin(ps0) * dx0 + sin(ps1) * dx1 + sin(ps2) * dx2 + sin(ps3) * dx3 + sin(ps4) * dx4);
    gya += wgt * sc * (sin(ps0) * dy0 + sin(ps1) * dy1 + sin(ps2) * dy2 + sin(ps3) * dy3 + sin(ps4) * dy4);
    pw2 = pw2 * 2;
}
pf = pacc / (5 * wsum);
sb = (pf * 0.5 + 1) * bands;
fr = fract(sb);
tri = abs(fr * 2 - 1);
lk = pow(tri, 1.1);
vxn = (0 - gxa) / (5 * wssum);
vyn = (0 - gya) / (5 * wssum);
vr = clamp(0.5 + 0.5 * gain * vxn, 0, 1);
vg = clamp(0.5 + 0.5 * gain * vyn, 0, 1);
sp = pf * 0.5 + 0.5;
keep = 1 - bypass_gate;
out1 = vec(lk * keep, lk * keep, lk * keep, 1);
out2 = vec(0.5 + (vr - 0.5) * keep, 0.5 + (vg - 0.5) * keep, 0.5, 1);
out3 = vec(sp * keep, sp * keep, sp * keep, 1);

// f_vf_erode -- stage 3 of 3: extent, then bypass and the source alpha (spec "Narrowed", plan ADR-9). Mirror: tests/modules/vf_erode/ink_mirror.extent_stage.
// One step of mass transport, on luma: flux = -(F T . grad L) - Lavg * T * div F, with T the travel in texels. Ink carried into a slope
// piles up, ink carried away from one starves it, and a converging field gathers ink. It is applied as one gain for the three
// channels, P = c * exp(clamp(extent * flux / max(Lavg, 0.02), -2.5, 1.6)), so ink keeps its own color and only its intensity changes,
// and it cannot go below 0 (Matt, 2026-11-09: the first form, additive per channel, showed as black). Output is not clamped (FR-010).
// Inputs, in order: the bulged image; the vecfield (RG, 0.5 is zero); the zapped source. With the connected flag at 0 the field is
// zero and this is exact identity. The field is read with sample(), since it can be any size: exact at 1:1.
zap_c(xv) {
    return switch(abs(xv) < 1e30, xv, 0.0);
}

luma_at(ut, vt) {
    return nearest(in1, vec(ut, vt)).x * 0.2126 + nearest(in1, vec(ut, vt)).y * 0.7152 + nearest(in1, vec(ut, vt)).z * 0.0722;
}

Param width(1920.0);
Param height(1080.0);
Param travel(0.5);
Param extent(0.0);
Param src_field(0.0);
Param bypass_gate(0.0);

s_tx = max(1.0, floor(0.003 * height + 0.5));
reach = travel * 0.05 * height;
ix = floor(norm.x * width);
iy = floor(norm.y * height);
ul = (clamp(ix - s_tx, 0.0, width - 1.0) + 0.5) / width;
ur = (clamp(ix + s_tx, 0.0, width - 1.0) + 0.5) / width;
vd = (clamp(iy - s_tx, 0.0, height - 1.0) + 0.5) / height;
vu = (clamp(iy + s_tx, 0.0, height - 1.0) + 0.5) / height;
um = (ix + 0.5) / width;
vm = (iy + 0.5) / height;

ux = (zap_c(sample(in2, norm).x) - 0.5) * 2.0 * reach * src_field;
uy = (zap_c(sample(in2, norm).y) - 0.5) * 2.0 * reach * src_field;
dfx = (zap_c(sample(in2, vec(ur, vm)).x) - zap_c(sample(in2, vec(ul, vm)).x)) * 2.0 / (2.0 * s_tx);
dfy = (zap_c(sample(in2, vec(um, vu)).y) - zap_c(sample(in2, vec(um, vd)).y)) * 2.0 / (2.0 * s_tx);
t_div = reach * (dfx + dfy) * src_field;

l_l = luma_at(ul, vm);
l_r = luma_at(ur, vm);
l_d = luma_at(um, vd);
l_u = luma_at(um, vu);
gx = (l_r - l_l) / (2.0 * s_tx);
gy = (l_u - l_d) / (2.0 * s_tx);
lavg = (l_l + l_r + l_d + l_u) * 0.25;
flux = 0.0 - (ux * gx + uy * gy) - lavg * t_div;
gain_e = exp(clamp(extent * flux / max(lavg, 0.02), -2.5, 1.6));

out1 = vec(mix(nearest(in1, norm).x * gain_e, nearest(in3, norm).x, bypass_gate), mix(nearest(in1, norm).y * gain_e, nearest(in3, norm).y, bypass_gate), mix(nearest(in1, norm).z * gain_e, nearest(in3, norm).z, bypass_gate), nearest(in3, norm).w);

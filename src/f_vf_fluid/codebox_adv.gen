// codebox_adv.gen -- f_vf_fluid stage 1: self-advect the velocity state and add
// the force. Mirror: tests/fluid_mirror.adv(). 256x256 float32.
//
// Inputs (jit.gl.pix inlets): in1 = `r draw` bang (unused; only triggers the
// render every frame), in2 = force f_vecfield at render resolution (via
// vs_inState), in3 = previous velocity state (R = u, B = v).
// Output: vec(u, 0, v, 0) in decoded f_vecfield units.
//
// Carried findings (Phase 0, 2026-09-23):
//   - the velocity is read with a manual 4-tap bilinear whose integer indices
//     wrap with wrap(): the flow domain is periodic and hardware sample()
//     clamps its neighbor tap (0.5 error at the seam)
//   - hardware sample() is used ONLY for the force: a codebox cannot read an
//     input texture's size, so manual taps are impossible there. It is exact at
//     1:1 and when magnifying, nearest-like when minifying, so a single tap at HD/4K
//     aliases a noisy force badly (E4 study, tasks.md T038: noise gain 4-12x)
//   - FORCE TAP GRID (T038a): the force is averaged over a taps x taps grid of hardware
//     taps spread across the target texel footprint. Offsets are in NORMALISED
//     coordinates, so no source size is needed. Default taps = 8: an ideal area average
//     at HD (noise gain 1.01), within 1.4x of it at 4K (single tap: 6x / 11.5x), for
//     ~0.6-0.7 ms. taps = 16 is ideal at both but costs ~1.5-1.7 ms, over the 3 ms frame
//     budget; taps = 1 is the old single tap. Cost ~ 2*taps^2 fetches per texel
//     (bench T021/T038a, tasks.md Findings).
//     The content gate below stays on the single centre tap.
//   - components are accessed inline on sample()/nearest(), never on a stored vec
//   - never name a Param `bypass`; `force`, `dt` are fine
Param dt(0.01);
Param force(0.02);
Param src_vecfield(0);
Param taps(8);

N = 256;
u = nearest(in3, norm).x;
v = nearest(in3, norm).z;

// departure point (continuous texel coordinates)
fx = (norm.x - u * dt) * N - 0.5;
fy = (norm.y - v * dt) * N - 0.5;
x0 = floor(fx);
y0 = floor(fy);
tx = fx - x0;
ty = fy - y0;
xa = wrap(x0, 0, N);
xb = wrap(x0 + 1, 0, N);
ya = wrap(y0, 0, N);
yb = wrap(y0 + 1, 0, N);
p00 = vec((xa + 0.5) / N, (ya + 0.5) / N);
p10 = vec((xb + 0.5) / N, (ya + 0.5) / N);
p01 = vec((xa + 0.5) / N, (yb + 0.5) / N);
p11 = vec((xb + 0.5) / N, (yb + 0.5) / N);
au = mix(mix(nearest(in3, p00).x, nearest(in3, p10).x, tx), mix(nearest(in3, p01).x, nearest(in3, p11).x, tx), ty);
av = mix(mix(nearest(in3, p00).z, nearest(in3, p10).z, tx), mix(nearest(in3, p01).z, nearest(in3, p11).z, tx), ty);

// force: decoded (p - 0.5) * 2. Gated by src_vecfield (0 = inlet unconnected) AND by the
// texture's own content: a real f_vecfield has B = 0.5 (contract), while vs_black is
// all zeros (decoded -1!). vs_inState's connected flag lags at load/disconnect, and a
// bogus -1 force leaves a phantom uniform velocity that decays only as fast as drag
// allows, so the flag alone is not enough (bench, 2026-09-23).
gate = switch(src_vecfield >= 0.5, 1, 0) * switch(abs(sample(in2, norm).z - 0.5) < 0.25, 1, 0);

// force tap grid (components inline on sample(), never on a stored vec)
tn = max(1, floor(taps));
sumx = 0;
sumy = 0;
for (a = 0; a < tn; a += 1) {
  ox = ((a + 0.5) / tn - 0.5) / N;
  for (b = 0; b < tn; b += 1) {
    oy = ((b + 0.5) / tn - 0.5) / N;
    sumx += sample(in2, vec(norm.x + ox, norm.y + oy)).x;
    sumy += sample(in2, vec(norm.x + ox, norm.y + oy)).y;
  }
}
fxa = sumx / (tn * tn);
fya = sumy / (tn * tn);
out1 = vec(au + force * (fxa - 0.5) * 2 * gate, 0, av + force * (fya - 0.5) * 2 * gate, 0);

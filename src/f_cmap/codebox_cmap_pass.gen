// codebox_cmap_pass.gen -- f_cmap feedback stage: the previous frame, NaN/Inf-guarded (NF-003).
// in1 = the primary's out1 (one frame old by the time the primary reads it). Texel-centre read, so same-size
// textures copy exactly. A zapped channel reads 0 (the f_wc pass guard: abs(x) < 1e30 is false for NaN and Inf;
// selection by switch(), not mix(), which would keep a NaN).
fbx = nearest(in1, norm).x;
fbx = switch(abs(fbx) < 1e30, fbx, 0.0);
fby = nearest(in1, norm).y;
fby = switch(abs(fby) < 1e30, fby, 0.0);
fbz = nearest(in1, norm).z;
fbz = switch(abs(fbz) < 1e30, fbz, 0.0);
fbw = nearest(in1, norm).w;
fbw = switch(abs(fbw) < 1e30, fbw, 0.0);
out1 = vec(fbx, fby, fbz, fbw);

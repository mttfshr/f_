// Stage B_h (f_tf_tensormap): horizontal bounded-loop box smooth of the
// three gradient products. in1 = stage A out1 (raw float32).
// Loop runs to the compile-time R_MAX (16, provisional -- T016/T017 pick
// the real value); tap i contributes only if |i| <= radius, via
// step(abs(i), radius). Result is divided by the ACTUAL tap count, so
// radius 0 is an identity pass. Cost scales with R_MAX, not live radius.
// Mirrors tests/test_tf_tensormap.py stage_b (axis 0). Edge taps are clamped in-shader (bench GPU wraps by default).
// Accumulators are scalar and pre-declared above the loop (GenExpr scope).
Param radius(3.0);
Param width(640.0);   // frame width in pixels; `dim` reads 1 live, so it is a Param

dx = 1.0 / width;
acc_xx = 0.0;
acc_xy = 0.0;
acc_yy = 0.0;
cnt = 0.0;
for (i = -16; i <= 16; i += 1) {
    wt = step(abs(i), radius);
    px = clamp(norm.x + i*dx, 0.5*dx, 1.0 - 0.5*dx);
    acc_xx = acc_xx + wt * nearest(in1, vec(px, norm.y)).x;
    acc_xy = acc_xy + wt * nearest(in1, vec(px, norm.y)).y;
    acc_yy = acc_yy + wt * nearest(in1, vec(px, norm.y)).z;
    cnt = cnt + wt;
}
inv = 1.0 / max(cnt, 1.0);

out1 = vec(acc_xx*inv, acc_xy*inv, acc_yy*inv, 1.0);

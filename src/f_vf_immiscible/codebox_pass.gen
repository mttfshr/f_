// codebox_pass.gen -- f_vf_immiscible stage 2: holds last frame's phi, or reseeds it. 256x256 float32.
// Mirror: immiscible_mirror.pass_stage() and hash01().
//
// Inputs: in1 = `r draw` bang (unused; it only triggers the render every frame and rides the HOT inlet,
// the feedback arrives on a cold inlet so it cannot retrigger the loop), in2 = the held state from the
// `hold` stage (R = phi).
// Output: R = phi; G, B, A = 0.
// reseed = 1 replaces phi with fill + amp * (2h - 1), h an arithmetic hash of the texel index and `salt`
// (no sin(): fract and multiply-add only, so precision does not depend on the GPU's sin range reduction).
//   - phi is reseeded ONLY on `reseed` or on a non-finite texel. A uniform phi = +1 or -1 is a legitimate
//     stable state (FR-010): there is NO zero-heal as in f_ks, whose u = 0 is a fixed point of a different kind
//   - selection uses switch(), not mix(): mix(NaN, x, 1) is still NaN
//   - the feedback is NaN/Inf-guarded with abs(x) < 1e30 (NaN == NaN is TRUE on this GPU)
//   - amp = 0.05 is RESEED_AMP of the mirror (T004: onset is 16-29 frames for amp 0.005-0.3, not critical).
//     The hash is the mirror's hash01(); change both together
//   - never name a variable e or phi (predefined constants)
Param reseed(0);
Param salt(0);
Param fill(0);

N = 256;
amp = 0.05;
cx = floor(norm.x * N);
cy = floor(norm.y * N);
hx = fract((cx + salt * 37) * 0.1031);
hy = fract((cy + salt * 17) * 0.1030);
hz = fract((cx + cy + salt * 5) * 0.0973);
hd = hx * (hy + 33.33) + hy * (hz + 33.33) + hz * (hx + 33.33);
hx = hx + hd;
hy = hy + hd;
hz = hz + hd;
hn = fract((hx + hy) * hz);

fb = nearest(in2, norm).x;
good = switch(abs(fb) < 1e30, 1, 0);
seeded = fill + amp * (2 * hn - 1);
use = max(1 - good, switch(reseed >= 0.5, 1, 0));
out1 = vec(switch(use >= 0.5, seeded, fb), 0, 0, 0);

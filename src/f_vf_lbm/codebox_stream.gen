// codebox_stream.gen -- f_vf_lbm stage 2: the streaming gather. 192x108 float32, three planes in, three out.
// Mirror: tests/modules/vf_lbm/vf_lbm_mirror.stream() (new[x] = old[x - e_i], FR-004).
//
// Population i of this texel is population i of the texel UPSTREAM, at x - e_i (the spike's trap #1: reading at
// x + e_i would reverse the flow, invisible until an obstacle is present). The reads use explicit periodic
// texel indices through wrap() and texel-centre nearest() taps, so they are exact and do not depend on how
// sample() treats out-of-range coordinates (the periodic seam in x is overwritten by the boundary branches in
// the collide stage, exactly as the mirror's np.roll-equivalent wrap is).
//   D2Q9: 0 rest; 1 (1,0); 2 (0,1); 3 (-1,0); 4 (0,-1); 5 (1,1); 6 (-1,1); 7 (-1,-1); 8 (1,-1)
//   plane 1 = populations 0..3 (RGBA), plane 2 = 4..7, plane 3 = 8 in R
W = 192;
H = 108;
px = floor(norm.x * W);
py = floor(norm.y * H);
cxc = (px + 0.5) / W;
cxm = (wrap(px - 1, 0, W) + 0.5) / W;
cxp = (wrap(px + 1, 0, W) + 0.5) / W;
cyc = (py + 0.5) / H;
cym = (wrap(py - 1, 0, H) + 0.5) / H;
cyp = (wrap(py + 1, 0, H) + 0.5) / H;

n0 = nearest(in1, vec(cxc, cyc)).x;
n1 = nearest(in1, vec(cxm, cyc)).y;
n2 = nearest(in1, vec(cxc, cym)).z;
n3 = nearest(in1, vec(cxp, cyc)).w;
n4 = nearest(in2, vec(cxc, cyp)).x;
n5 = nearest(in2, vec(cxm, cym)).y;
n6 = nearest(in2, vec(cxp, cym)).z;
n7 = nearest(in2, vec(cxp, cyp)).w;
n8 = nearest(in3, vec(cxm, cyp)).x;

out1 = vec(n0, n1, n2, n3);
out2 = vec(n4, n5, n6, n7);
out3 = vec(n8, 0, 0, 0);

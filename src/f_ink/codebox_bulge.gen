// f_ink -- stage 2 of 3: bulge. Only the edges move along the field (spec "Narrowed", plan ADR-9). Mirror: tests/modules/ink/ink_mirror.bulge_stage.
// Each channel is read back along the field by T * bulge * e. T is the travel in texels; e rises with the channel's local slope, so
// a flat interior holds still and the outline ripples. On smooth tone the slope is what stands in for an edge.
// Inputs, in order: the zapped image; the vecfield (RG, 0.5 is zero, 0..1 is -1..1). With the connected flag at 0 the field is zero.
// The read is a manual bilinear from four nearest() taps per channel, because a coordinate that jumps between neighbors makes
// hardware sample() fall back to nearest. width and height come from render_dim: `dim` reads 1 in a live jit.gl.pix.
bil_r(xc, yc, w_tx, h_tx) {
    tx = clamp(xc - 0.5, 0.0, w_tx - 1.0);
    ty = clamp(yc - 0.5, 0.0, h_tx - 1.0);
    i0 = floor(tx);
    j0 = floor(ty);
    ax = tx - i0;
    ay = ty - j0;
    u0 = (i0 + 0.5) / w_tx;
    u1 = (min(i0 + 1.0, w_tx - 1.0) + 0.5) / w_tx;
    v0 = (j0 + 0.5) / h_tx;
    v1 = (min(j0 + 1.0, h_tx - 1.0) + 0.5) / h_tx;
    near_row = nearest(in1, vec(u0, v0)).x * (1.0 - ax) + nearest(in1, vec(u1, v0)).x * ax;
    far_row = nearest(in1, vec(u0, v1)).x * (1.0 - ax) + nearest(in1, vec(u1, v1)).x * ax;
    return near_row * (1.0 - ay) + far_row * ay;
}

bil_g(xc, yc, w_tx, h_tx) {
    tx = clamp(xc - 0.5, 0.0, w_tx - 1.0);
    ty = clamp(yc - 0.5, 0.0, h_tx - 1.0);
    i0 = floor(tx);
    j0 = floor(ty);
    ax = tx - i0;
    ay = ty - j0;
    u0 = (i0 + 0.5) / w_tx;
    u1 = (min(i0 + 1.0, w_tx - 1.0) + 0.5) / w_tx;
    v0 = (j0 + 0.5) / h_tx;
    v1 = (min(j0 + 1.0, h_tx - 1.0) + 0.5) / h_tx;
    near_row = nearest(in1, vec(u0, v0)).y * (1.0 - ax) + nearest(in1, vec(u1, v0)).y * ax;
    far_row = nearest(in1, vec(u0, v1)).y * (1.0 - ax) + nearest(in1, vec(u1, v1)).y * ax;
    return near_row * (1.0 - ay) + far_row * ay;
}

bil_b(xc, yc, w_tx, h_tx) {
    tx = clamp(xc - 0.5, 0.0, w_tx - 1.0);
    ty = clamp(yc - 0.5, 0.0, h_tx - 1.0);
    i0 = floor(tx);
    j0 = floor(ty);
    ax = tx - i0;
    ay = ty - j0;
    u0 = (i0 + 0.5) / w_tx;
    u1 = (min(i0 + 1.0, w_tx - 1.0) + 0.5) / w_tx;
    v0 = (j0 + 0.5) / h_tx;
    v1 = (min(j0 + 1.0, h_tx - 1.0) + 0.5) / h_tx;
    near_row = nearest(in1, vec(u0, v0)).z * (1.0 - ax) + nearest(in1, vec(u1, v0)).z * ax;
    far_row = nearest(in1, vec(u0, v1)).z * (1.0 - ax) + nearest(in1, vec(u1, v1)).z * ax;
    return near_row * (1.0 - ay) + far_row * ay;
}

edge_w(cl, cr, cd, cu, s_tx, h_tx) {
    gx = (cr - cl) / (2.0 * s_tx);
    gy = (cu - cd) / (2.0 * s_tx);
    return clamp(sqrt(gx * gx + gy * gy) * h_tx / 7.0, 0.0, 1.0);
}

zap_c(xv) {
    return switch(abs(xv) < 1e30, xv, 0.0);
}

Param width(1920.0);
Param height(1080.0);
Param travel(0.5);
Param bulge(0.0);
Param src_field(0.0);

s_tx = max(1.0, floor(0.003 * height + 0.5));
reach = travel * 0.05 * height * bulge;
ix = floor(norm.x * width);
iy = floor(norm.y * height);
xc = ix + 0.5;
yc = iy + 0.5;
ul = (clamp(ix - s_tx, 0.0, width - 1.0) + 0.5) / width;
ur = (clamp(ix + s_tx, 0.0, width - 1.0) + 0.5) / width;
vd = (clamp(iy - s_tx, 0.0, height - 1.0) + 0.5) / height;
vu = (clamp(iy + s_tx, 0.0, height - 1.0) + 0.5) / height;
um = xc / width;
vm = yc / height;

ffx = (zap_c(sample(in2, norm).x) - 0.5) * 2.0 * reach * src_field;
ffy = (zap_c(sample(in2, norm).y) - 0.5) * 2.0 * reach * src_field;

e_r = edge_w(nearest(in1, vec(ul, vm)).x, nearest(in1, vec(ur, vm)).x, nearest(in1, vec(um, vd)).x, nearest(in1, vec(um, vu)).x, s_tx, height);
e_g = edge_w(nearest(in1, vec(ul, vm)).y, nearest(in1, vec(ur, vm)).y, nearest(in1, vec(um, vd)).y, nearest(in1, vec(um, vu)).y, s_tx, height);
e_b = edge_w(nearest(in1, vec(ul, vm)).z, nearest(in1, vec(ur, vm)).z, nearest(in1, vec(um, vd)).z, nearest(in1, vec(um, vu)).z, s_tx, height);

out1 = vec(bil_r(xc - ffx * e_r, yc - ffy * e_r, width, height), bil_g(xc - ffx * e_g, yc - ffy * e_g, width, height), bil_b(xc - ffx * e_b, yc - ffy * e_b, width, height), 1.0);

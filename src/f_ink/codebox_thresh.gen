// f_ink -- the re-threshold of spread (spec FR-004, plan ADR-2, T021). Mirror: tests/modules/ink/ink_mirror.threshold.
// H = smoothstep(0.5 - w/2 - bias, 0.5 + w/2 - bias, B), then S = mix(B, H, snap * min(spread / 0.125, 1)).
// snap 0 is a plain blur, which keeps continuous tone; snap 1 hardens the blur back into a mark (Matt, 2026-11-08).
// At spread 0 the blend factor is exactly 0, so the input passes unchanged. Alpha is restored in the last stage.
// 0.125 is SNAP_GATE (inferred, tuned at T032); 0.001 keeps smoothstep's edges apart at soften 0.
hard_c(bc, lo_e, hi_e, amt) {
    held = smoothstep(lo_e, hi_e, bc);
    return bc * (1.0 - amt) + held * amt;
}

Param spread(0.0);
Param snap(1.0);
Param bias(0.0);
Param soften(0.2);

soft_w = max(soften, 0.001);
lo_edge = 0.5 - soft_w * 0.5 - bias;
hi_edge = 0.5 + soft_w * 0.5 - bias;
blend_amt = snap * min(spread / 0.125, 1.0);

out1 = vec(hard_c(nearest(in1, norm).x, lo_edge, hi_edge, blend_amt), hard_c(nearest(in1, norm).y, lo_edge, hi_edge, blend_amt), hard_c(nearest(in1, norm).z, lo_edge, hi_edge, blend_amt), 1.0);

// codebox_seed.gen -- f_wc PARITY seed stage (spec Revision 2, S6).
// One-time uniform "uint8" random in all four channels, k/255 (the page's GPUNoise.randomize
// writes uniform bytes into R, G, B, A). Hash noise, deterministic per texel per salt.
// Mirror: wc_parity_mirror.seed_state() (the distribution; the hash is not bit-matched to numpy's rng).
//   - salt advances once per RESET (the raw wiring), NOT per frame: the page has no per-frame noise
//   - grid size: Param n (default 1024 = the definition's @dim) -- never the gen `dim` global
//   - no sin(): a Hoskins-style arithmetic hash; functions are declared before Params (GenExpr rule)
//   - uint8-like: min(floor(h * 256), 255) / 255 on every channel
hashf(x, y) {
	ha = fract(x * 0.1031);
	hb = fract(y * 0.1031);
	hc = ha;
	hd = ha * (hb + 33.33) + hb * (hc + 33.33) + hc * (ha + 33.33);
	ha = ha + hd;
	hb = hb + hd;
	hc = hc + hd;
	return fract((ha + hb) * hc);
}

Param salt(0);
Param n(1024);

px = floor(norm.x * n);
py = floor(norm.y * n);

sa = salt * 61;
sb = salt * 17;
h0 = hashf(px + sa, py + sb);
h1 = hashf(px + sa + 113.7, py + sb + 57.3);
h2 = hashf(px + sa + 271.9, py + sb + 181.3);
h3 = hashf(px + sa + 401.1, py + sb + 333.7);

out1 = vec(min(floor(h0 * 256), 255) / 255, min(floor(h1 * 256), 255) / 255,
           min(floor(h2 * 256), 255) / 255, min(floor(h3 * 256), 255) / 255);

// dt/decay/injection literals fixed 2026-10-15 to match definition.py's declared
// defaults (0.01/0.97/0.02) -- they'd drifted to 0.02/0.95/0.05. jit.gl.pix drops
// a param sent before its gen's first-render compile (bench-verified, jit-gen-codebox
// skill), so a freshly-loaded instance can silently boot at the codebox's own stale
// literal instead of the dial's intended value; see f_vf_vorticity's confinement bug
// for the full mechanism, and tests/module_contract.py's default_mismatch check.
Param dt(0.01);
Param decay(0.97);
Param injection(0.02);
Param gain(1.0);
Param mix_pct(100.0);
Param bypass_gate(0.0);
Param src_vecfield(0.0);

uv = norm;

// Vecfield: sample inline (no stored variable component access)
fx = (sample(in2, uv).x - 0.5) * 2.0;
fy = (sample(in2, uv).y - 0.5) * 2.0;

// Suppress displacement when vecfield unconnected (src_vecfield = 0)
connected = step(0.5, src_vecfield);
fx = fx * connected;
fy = fy * connected;

// Backward-displaced UV, clamped to edge. Bounds are 0.001 / 0.999, NOT 0 / 1: on the GPU a
// coordinate of exactly x = 1.0 or y = 0.0 sits on the wrap seam and reads the OPPOSITE edge
// (probe P9, 2026-10-20), and here the wrong edge would be re-injected every frame of the loop.
src_uv = vec(clamp(uv.x - fx * dt, 0.001, 0.999), clamp(uv.y - fy * dt, 0.001, 0.999));

// Advect previous frame, add source injection
advected = sample(in3, src_uv) * decay;
result = clamp(advected + sample(in1, uv) * injection, 0.0, 1.0);

// Wet/dry, then bypass (bypass_mode "param"): passthrough on every outlet (Matt, 2026-10-05).
// out1 feeds the pass stage, so the feedback loop carries the source while bypassed.
driven = clamp(result * gain, 0.0, 1.0);
mixed = mix(sample(in1, uv), driven, mix_pct / 100.0);
out1 = mix(mixed, sample(in1, uv), bypass_gate);
out2 = mix(result, sample(in1, uv), bypass_gate);

// --- 3rd outlet: gradient of accumulated flow (luma-reduced central
// difference on the feedback texture in3, per ADR 6 / spec.md's
// 2026-07-11 reframe -- result itself is a per-pixel value, not a
// resamplable texture within this pass, so in3 (the previous frame's
// accumulation, the same signal result derives from) stands in as the
// best available proxy for "shape of the accumulated flow" ) ---
grad_scale = 0.004;
grad_gain  = 4.0;

L_right = sample(in3, vec(uv.x + grad_scale, uv.y)).x * 0.299 + sample(in3, vec(uv.x + grad_scale, uv.y)).y * 0.587 + sample(in3, vec(uv.x + grad_scale, uv.y)).z * 0.114;
L_left  = sample(in3, vec(uv.x - grad_scale, uv.y)).x * 0.299 + sample(in3, vec(uv.x - grad_scale, uv.y)).y * 0.587 + sample(in3, vec(uv.x - grad_scale, uv.y)).z * 0.114;
L_down  = sample(in3, vec(uv.x, uv.y + grad_scale)).x * 0.299 + sample(in3, vec(uv.x, uv.y + grad_scale)).y * 0.587 + sample(in3, vec(uv.x, uv.y + grad_scale)).z * 0.114;
L_up    = sample(in3, vec(uv.x, uv.y - grad_scale)).x * 0.299 + sample(in3, vec(uv.x, uv.y - grad_scale)).y * 0.587 + sample(in3, vec(uv.x, uv.y - grad_scale)).z * 0.114;

gx = (L_right - L_left) * grad_gain;
gy = (L_down  - L_up)   * grad_gain;

field   = vec(clamp(gx * 0.5 + 0.5, 0.0, 1.0), clamp(gy * 0.5 + 0.5, 0.0, 1.0), 0.5, 1.0);

// bypassed: the vecfield input passed through (neutral 0.5 when it is unconnected)
out3 = mix(field, vec(mix(0.5, sample(in2, uv).x, connected), mix(0.5, sample(in2, uv).y, connected), 0.5, 1.0), bypass_gate);

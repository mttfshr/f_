// codebox_blur_y.gen -- f_formconstants PARITY blur stage, Y pass (spec Revision 2, S2 + S3).
// Port of lib/gpugaussian.js GPUGaussianMultiBlur(gl, 1, 2, 1, 1): per-channel sigma
// R = 1 (E), G = 2 (I), B = 1, A = 1; ONE shared radius ceil(3 * 2) = 6, so the sigma = 1
// kernel is also 13 taps; weights exp(-0.5 (i/sigma)^2) normalized over [-6, 6]; taps at exact
// integer texel offsets, wrap (REPEAT); the result divided by w0 + 2*sum(w_i) (the page does) and
// quantized floor(255 c + 0.5)/255 on all four channels (S2).
// Weights are LITERALS generated from tests/modules/formconstants/fc_parity_mirror.half_kernel()
// (test_fc_codebox_static.py re-parses this file and compares them). Mirror: fc_parity_mirror.blur_pass.
// Grid size: Param n (default 1024 = the definition's @dim, S1) -- NEVER the gen `dim` global.
// Wrap is explicit modulo on the texel index (the verified f_wc / f_formconstants pattern); reads are
// nearest() at texel centres, normalized coordinates. GenExpr discipline: no functions, everything
// inlined with suffixed names.
// Phase D T072 (Matt, 2026-10-25): Param grain_scale from the Grain dial (0.5-2, default 1) -- every
// tap's offset i becomes i * grain_scale, read as two wrapped texels blended by the fraction (same 13
// taps and weights; at 1 the fraction is 0, so the parity path is exact). Above ~1.5 the spaced taps
// alias into a checkerboard moire (tests/records/spike_fc_grain_inhibit.py) -- kept on purpose (Matt).
// Phase D T062 (Matt, 2026-10-25): Param q_levels from the Quant menu -- 0 = 255 levels (the source,
// S2), 1 = 1023, 2 = float (no quantization). Every level >= 255 lives; below 255 the field freezes
// (tests/records/spike_fc_quant_levels.py), so the menu offers only the living span.
Param n(1024);
Param q_levels(0);
Param grain_scale(1);

ix = floor(norm.x * n);
iy = floor(norm.y * n);
xw0 = ix - n * floor(ix / n);
t0 = nearest(in1, vec((xw0 + 0.5) / n, (iy + 0.5) / n));
ar = t0.x * 0.398942292; ag = t0.y * 0.199675635; ab = t0.z * 0.398942292; aa = t0.w * 0.398942292;
dp1 = iy + 1 * grain_scale; fp1 = floor(dp1); rp1 = dp1 - fp1;
pa1 = fp1 - n * floor(fp1 / n); pb1 = (fp1 + 1) - n * floor((fp1 + 1) / n);
tp1 = mix(nearest(in1, vec((xw0 + 0.5) / n, (pa1 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (pb1 + 0.5) / n)), rp1);
dn1 = iy - 1 * grain_scale; fn1 = floor(dn1); rn1 = dn1 - fn1;
na1 = fn1 - n * floor(fn1 / n); nb1 = (fn1 + 1) - n * floor((fn1 + 1) / n);
tn1 = mix(nearest(in1, vec((xw0 + 0.5) / n, (na1 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (nb1 + 0.5) / n)), rn1);
ar = ar + (tp1.x + tn1.x) * 0.241970718; ag = ag + (tp1.y + tn1.y) * 0.176213115; ab = ab + (tp1.z + tn1.z) * 0.241970718; aa = aa + (tp1.w + tn1.w) * 0.241970718;
dp2 = iy + 2 * grain_scale; fp2 = floor(dp2); rp2 = dp2 - fp2;
pa2 = fp2 - n * floor(fp2 / n); pb2 = (fp2 + 1) - n * floor((fp2 + 1) / n);
tp2 = mix(nearest(in1, vec((xw0 + 0.5) / n, (pa2 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (pb2 + 0.5) / n)), rp2);
dn2 = iy - 2 * grain_scale; fn2 = floor(dn2); rn2 = dn2 - fn2;
na2 = fn2 - n * floor(fn2 / n); nb2 = (fn2 + 1) - n * floor((fn2 + 1) / n);
tn2 = mix(nearest(in1, vec((xw0 + 0.5) / n, (na2 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (nb2 + 0.5) / n)), rn2);
ar = ar + (tp2.x + tn2.x) * 0.0539909676; ag = ag + (tp2.y + tn2.y) * 0.121109389; ab = ab + (tp2.z + tn2.z) * 0.0539909676; aa = aa + (tp2.w + tn2.w) * 0.0539909676;
dp3 = iy + 3 * grain_scale; fp3 = floor(dp3); rp3 = dp3 - fp3;
pa3 = fp3 - n * floor(fp3 / n); pb3 = (fp3 + 1) - n * floor((fp3 + 1) / n);
tp3 = mix(nearest(in1, vec((xw0 + 0.5) / n, (pa3 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (pb3 + 0.5) / n)), rp3);
dn3 = iy - 3 * grain_scale; fn3 = floor(dn3); rn3 = dn3 - fn3;
na3 = fn3 - n * floor(fn3 / n); nb3 = (fn3 + 1) - n * floor((fn3 + 1) / n);
tn3 = mix(nearest(in1, vec((xw0 + 0.5) / n, (na3 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (nb3 + 0.5) / n)), rn3);
ar = ar + (tp3.x + tn3.x) * 0.00443184841; ag = ag + (tp3.y + tn3.y) * 0.0648251846; ab = ab + (tp3.z + tn3.z) * 0.00443184841; aa = aa + (tp3.w + tn3.w) * 0.00443184841;
dp4 = iy + 4 * grain_scale; fp4 = floor(dp4); rp4 = dp4 - fp4;
pa4 = fp4 - n * floor(fp4 / n); pb4 = (fp4 + 1) - n * floor((fp4 + 1) / n);
tp4 = mix(nearest(in1, vec((xw0 + 0.5) / n, (pa4 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (pb4 + 0.5) / n)), rp4);
dn4 = iy - 4 * grain_scale; fn4 = floor(dn4); rn4 = dn4 - fn4;
na4 = fn4 - n * floor(fn4 / n); nb4 = (fn4 + 1) - n * floor((fn4 + 1) / n);
tn4 = mix(nearest(in1, vec((xw0 + 0.5) / n, (na4 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (nb4 + 0.5) / n)), rn4);
ar = ar + (tp4.x + tn4.x) * 0.000133830225; ag = ag + (tp4.y + tn4.y) * 0.0270231571; ab = ab + (tp4.z + tn4.z) * 0.000133830225; aa = aa + (tp4.w + tn4.w) * 0.000133830225;
dp5 = iy + 5 * grain_scale; fp5 = floor(dp5); rp5 = dp5 - fp5;
pa5 = fp5 - n * floor(fp5 / n); pb5 = (fp5 + 1) - n * floor((fp5 + 1) / n);
tp5 = mix(nearest(in1, vec((xw0 + 0.5) / n, (pa5 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (pb5 + 0.5) / n)), rp5);
dn5 = iy - 5 * grain_scale; fn5 = floor(dn5); rn5 = dn5 - fn5;
na5 = fn5 - n * floor(fn5 / n); nb5 = (fn5 + 1) - n * floor((fn5 + 1) / n);
tn5 = mix(nearest(in1, vec((xw0 + 0.5) / n, (na5 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (nb5 + 0.5) / n)), rn5);
ar = ar + (tp5.x + tn5.x) * 1.4867195e-06; ag = ag + (tp5.y + tn5.y) * 0.00877313502; ab = ab + (tp5.z + tn5.z) * 1.4867195e-06; aa = aa + (tp5.w + tn5.w) * 1.4867195e-06;
dp6 = iy + 6 * grain_scale; fp6 = floor(dp6); rp6 = dp6 - fp6;
pa6 = fp6 - n * floor(fp6 / n); pb6 = (fp6 + 1) - n * floor((fp6 + 1) / n);
tp6 = mix(nearest(in1, vec((xw0 + 0.5) / n, (pa6 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (pb6 + 0.5) / n)), rp6);
dn6 = iy - 6 * grain_scale; fn6 = floor(dn6); rn6 = dn6 - fn6;
na6 = fn6 - n * floor(fn6 / n); nb6 = (fn6 + 1) - n * floor((fn6 + 1) / n);
tn6 = mix(nearest(in1, vec((xw0 + 0.5) / n, (na6 + 0.5) / n)), nearest(in1, vec((xw0 + 0.5) / n, (nb6 + 0.5) / n)), rn6);
ar = ar + (tp6.x + tn6.x) * 6.07588291e-09; ag = ag + (tp6.y + tn6.y) * 0.00221819594; ab = ab + (tp6.z + tn6.z) * 6.07588291e-09; aa = aa + (tp6.w + tn6.w) * 6.07588291e-09;
lv = 255 + 768 * (q_levels > 0.5);
qon = q_levels < 1.5;
qr = mix(ar, floor(lv * ar + 0.5) / lv, qon);
qg = mix(ag, floor(lv * ag + 0.5) / lv, qon);
qb = mix(ab, floor(lv * ab + 0.5) / lv, qon);
qa = mix(aa, floor(lv * aa + 0.5) / lv, qon);
out1 = vec(qr, qg, qb, qa);

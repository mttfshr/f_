// codebox_enc.gen -- f_formconstants PARITY render stage (spec Revision 2, S7 + S8).
// Port of the page's `retinalmap` shader on the module's output size: z = canvas coordinate in
// [-1, 1]^2 of the SQUARE canvas (the page's CSS stretch crops the long axis), then the state is
// sampled at (atan2(z.y, z.x), ln |z|) / 2 pi with LINEAR filtering and REPEAT wrap. The bare
// complex log: conformal, one texture width per revolution; over most of the screen it MAGNIFIES
// the 1024^2 field (the silky read). No foveal softening, contrast or sharp in the parity build.
// Display (S8): the sampled state's E, I and contour channels, alpha 1 -- then the output mode
// (Phase D T060, Param out_mode from the Output menu): 0 RGB = (E, I, contour) as the page; 1 E,
// 2 contour, 3 Rec. 709 luma of that RGB, each as a gray (v, v, v, 1). Branch-free selection.
// Mirror: fc_parity_mirror.encode_mode() (encode() for mode 0).
// Phase D T074 (Matt, 2026-10-25): Param out_view from the View menu -- 0 Retinal (the map above), 1
// Unwrapped: the solver grid itself (cortical space) (angle across, log-radius up, one period each; periodic in
// both axes, so it tiles) -- the input for f_droste or any downstream log-polar wrap.
// Inputs: in1 = the `r draw` bang (unused), in2 = the state (from nl).
//   - output size: Params ow, oh (raw `r dim` -> route -> unpack -> prepend param); NOT the gen `dim`
//     global (it is not an input texture's size). State grid size: Param n (default 1024 = @dim)
//   - L = max(ow, oh); zx = (2x - 1) ow/L, zy = (2y - 1) oh/L with texel-centred norm
//   - manual bilinear with explicit wrap on the texel index (the verified pattern); cortical axes:
//     texture x = angle, texture y = log radius (the mirror's convention)
//   - r floored at 1e-6 (ln 0): the page leaves the exact centre undefined
//   - bypass_gate = 1 outputs black with alpha 1; the solver keeps running upstream. Never a Param
//     named `bypass` (native pix attribute)
//   - the cartopol multi-assign is the construct the verified f_formconstants enc bench (8/8) used
Param bypass_gate(0);
Param ow(1024);
Param oh(1024);
Param n(1024);
Param out_mode(1);
Param out_view(0);
Param deflicker_amt(0);

lng = max(ow, oh);
zx = (norm.x * 2 - 1) * ow / lng;
zy = (norm.y * 2 - 1) * oh / lng;
r, theta = cartopol(zx, zy);
rr = max(r, 0.000001);
u = mix(theta / twopi, norm.x, out_view);
v = mix(log(rr) / twopi, norm.y, out_view);

fx = u * n - 0.5;
fy = v * n - 0.5;
x0 = floor(fx);
y0 = floor(fy);
tx = fx - x0;
ty = fy - y0;
xa0 = x0 - n * floor(x0 / n);
xb0 = (x0 + 1) - n * floor((x0 + 1) / n);
ya0 = y0 - n * floor(y0 / n);
yb0 = (y0 + 1) - n * floor((y0 + 1) / n);
cxa = (xa0 + 0.5) / n;
cxb = (xb0 + 0.5) / n;
cya = (ya0 + 0.5) / n;
cyb = (yb0 + 0.5) / n;
t00 = nearest(in2, vec(cxa, cya));
t10 = nearest(in2, vec(cxb, cya));
t01 = nearest(in2, vec(cxa, cyb));
t11 = nearest(in2, vec(cxb, cyb));
le = (1 - ty) * ((1 - tx) * t00.x + tx * t10.x) + ty * ((1 - tx) * t01.x + tx * t11.x);
li = (1 - ty) * ((1 - tx) * t00.y + tx * t10.y) + ty * ((1 - tx) * t01.y + tx * t11.y);
lb = (1 - ty) * ((1 - tx) * t00.z + tx * t10.z) + ty * ((1 - tx) * t01.z + tx * t11.z);
k = 1 - bypass_gate;

// Phase D T075 De-flicker (Matt 2026-10-25): in3 = the current field means (mean4), in4 = the usual
// means (track). Per channel gain clamp(usual / cur, 0, 4), applied by deflicker_amt (0 = the source).
// Until the tracker holds a value (alpha 0) the gains are 1. Mirror: deflicker_gains / encode_mode(gains=).
fcur = nearest(in3, vec(0.5, 0.5));
fus = nearest(in4, vec(0.5, 0.5));
famt = deflicker_amt * (fus.w > 0.5);
le = le * mix(1, clamp(fus.x / max(fcur.x, 0.0001), 0, 4), famt);
li = li * mix(1, clamp(fus.y / max(fcur.y, 0.0001), 0, 4), famt);
lb = lb * mix(1, clamp(fus.z / max(fcur.z, 0.0001), 0, 4), famt);

lum = 0.2126 * le + 0.7152 * li + 0.0722 * lb;
m1 = abs(out_mode - 1) < 0.5;
m2 = abs(out_mode - 2) < 0.5;
m3 = out_mode > 2.5;
gv = m1 * le + m2 * lb + m3 * lum;
gsel = out_mode > 0.5;
oc0 = mix(le, gv, gsel);
oc1 = mix(li, gv, gsel);
oc2 = mix(lb, gv, gsel);

out1 = vec(oc0 * k, oc1 * k, oc2 * k, 1);

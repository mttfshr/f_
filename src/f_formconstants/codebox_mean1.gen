// f_formconstants -- mean1 (Phase D T075 De-flicker, Matt 2026-10-25). GENERATED literal taps
// (regenerate if the solver size changes, T064). 1024 x 1024 -> 128 x 128: each output texel is the
// mean of its 8 x 8 input block. Each tap is a bilinear `sample` exactly on a texel corner (a 2 x 2
// average, weights 0.25), 4 x 4 taps cover the block. Kept to <= 16 taps per stage: a 256-tap
// version broke jit.gl.pix's shader translator ('stack overflow (too many captures)', 2026-10-25).
// Chain: mean1 1024->128, mean2 ->16, mean3 ->2, mean4 ->1. Mirror: fc_parity_mirror.frame_means.
bx = floor(norm.x * 128) * 8;
by = floor(norm.y * 128) * 8;
acc = vec(0, 0, 0, 0);
acc = acc + sample(in1, vec((bx + 1) / 1024, (by + 1) / 1024));
acc = acc + sample(in1, vec((bx + 1) / 1024, (by + 3) / 1024));
acc = acc + sample(in1, vec((bx + 1) / 1024, (by + 5) / 1024));
acc = acc + sample(in1, vec((bx + 1) / 1024, (by + 7) / 1024));
acc = acc + sample(in1, vec((bx + 3) / 1024, (by + 1) / 1024));
acc = acc + sample(in1, vec((bx + 3) / 1024, (by + 3) / 1024));
acc = acc + sample(in1, vec((bx + 3) / 1024, (by + 5) / 1024));
acc = acc + sample(in1, vec((bx + 3) / 1024, (by + 7) / 1024));
acc = acc + sample(in1, vec((bx + 5) / 1024, (by + 1) / 1024));
acc = acc + sample(in1, vec((bx + 5) / 1024, (by + 3) / 1024));
acc = acc + sample(in1, vec((bx + 5) / 1024, (by + 5) / 1024));
acc = acc + sample(in1, vec((bx + 5) / 1024, (by + 7) / 1024));
acc = acc + sample(in1, vec((bx + 7) / 1024, (by + 1) / 1024));
acc = acc + sample(in1, vec((bx + 7) / 1024, (by + 3) / 1024));
acc = acc + sample(in1, vec((bx + 7) / 1024, (by + 5) / 1024));
acc = acc + sample(in1, vec((bx + 7) / 1024, (by + 7) / 1024));
out1 = acc / 16;

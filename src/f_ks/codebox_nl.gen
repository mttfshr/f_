// codebox_nl.gen -- f_ks stage 6: the real-space nonlinearity, on the linear-step result.
// u_new = u_lin - dt * 0.5 * |grad u_lin|^2 with periodic central differences. 256x256 float32.
// Mirror: tests/modules/ks/ks_mirror.nonlinear_step().
//
// Input in1 = u_lin (R, from the ix stage). Output R = u_new, A = 1: this is the solver state and
// the feedback edge (nl -> pass).
//   - neighbors are read with integer indices wrapped by wrap() and normalized texel-centre
//     coordinates: the domain is periodic and nothing relies on sampler wrap behavior
//   - dx = L / N, so 1 / dx = N / L
//   - containment: a non-finite or huge result is zapped / clamped here, so the feedback loop can
//     never carry NaN/Inf (FR-008). The clamp (+-100) is far above the measured |u| (15 to 20 at
//     the dt ceiling) and is inactive in normal running; it is a backstop, modeled in the mirror
Param dt(0.05);
Param L(50);

N = 256;
bx = floor(norm.x * N);
by = floor(norm.y * N);
xp = (wrap(bx + 1, 0, N) + 0.5) / N;
xm = (wrap(bx - 1, 0, N) + 0.5) / N;
yp = (wrap(by + 1, 0, N) + 0.5) / N;
ym = (wrap(by - 1, 0, N) + 0.5) / N;
inv_dx = N / L;
gx = (nearest(in1, vec(xp, norm.y)).x - nearest(in1, vec(xm, norm.y)).x) * (0.5 * inv_dx);
gy = (nearest(in1, vec(norm.x, yp)).x - nearest(in1, vec(norm.x, ym)).x) * (0.5 * inv_dx);
q = gx * gx + gy * gy;
un = nearest(in1, norm).x - dt * 0.5 * q;
un = switch(abs(un) < 1e30, un, 0);
un = clamp(un, -100, 100);

out1 = vec(un, 0, 0, 1);

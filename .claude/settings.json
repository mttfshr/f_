{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tests/run.sh -q tests/:*)",
      "Bash(tests/py.sh tests/:*)",
      "Bash(tests/bg.sh status:*)",
      "Bash(tests/bg.sh log:*)",
      "Bash(tests/bg.sh list)",
      "Bash(build/py.sh build/generate_menu.py --check)",
      "Bash(build/py.sh build/generate_launch.py --check)",
      "Bash(build/py.sh build/generate_bluenoise.py --check)"
    ],
    "ask": [
      "Bash(tests/bench.sh:*)",
      "Bash(tests/check.sh full:*)",
      "Bash(tests/bg.sh start bench:*)",
      "Bash(tests/bg.sh start all:*)",
      "Bash(build/release.sh:*)"
    ]
  }
}
